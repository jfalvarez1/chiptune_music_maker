// ============================================================================
// Windows resources
//
// The application icon, and the version block Explorer reads for the file
// properties dialog.
//
// The icon is the FIRST icon resource in the file on purpose: Windows uses
// the lowest-numbered one as the application icon, so anything added later
// must be given a higher id or it silently takes over the taskbar.
// ============================================================================

#include <windows.h>

// IDI_APPICON must stay 1 - see above.
1 ICON "ChiptuneTracker.ico"

// The version block. Kept in step with src/Version.h by hand, which is a
// duplication worth noting: Version.h is the source of truth for anything
// the program shows, and this is what Explorer shows.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    3,9,0,0
 PRODUCTVERSION 3,9,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ChiptuneTracker - a tracker-style DAW for chiptune"
            VALUE "FileVersion",     "3.9.0.0"
            VALUE "InternalName",    "ChiptuneTracker"
            VALUE "OriginalFilename","ChiptuneTracker.exe"
            VALUE "ProductName",     "ChiptuneTracker"
            VALUE "ProductVersion",  "3.9.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
